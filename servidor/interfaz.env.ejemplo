# Configuración del servidor de la interfaz.
#
# Despliegue actual: Google Cloud (Cloud Run "martian-front", dominio martian-map.page).
# Ahí estas variables las pone el workflow .github/workflows/deploy-gcp.yml:
# los tres backends pasan por el backend privado de capas ("martian-layers"),
# que reenvía análisis y monitoreo a la VM privada de análisis.
#
# Este archivo sirve para correr el servidor en otra máquina (por ejemplo, la guía
# de AWS en servidor/README.md): copiarlo a /etc/martian-interfaz.env y ajustar.

# Puerto donde escucha el servidor de la interfaz.
PORT=8080
HOST=0.0.0.0

# Backends (de servidor a servidor: pueden ser http, por IP o privados).
# Si están en la misma máquina, usar http://localhost:PUERTO.
BACKEND_1_URL=https://martian-layers-712630786686.southamerica-west1.run.app
BACKEND_2_URL=https://martian-layers-712630786686.southamerica-west1.run.app
# Monitoreo en tiempo real (POST /api/monitoreo).
BACKEND_MONITOREO_URL=https://martian-layers-712630786686.southamerica-west1.run.app

# Solo en Google Cloud: el backend de capas es privado y pide un token de identidad
# con esta audiencia (el servidor lo obtiene de la cuenta de servicio de Cloud Run).
# Fuera de Google Cloud, dejarla vacía y usar backends accesibles sin token.
BACKEND_IDENTITY_AUDIENCE=https://martian-layers-712630786686.southamerica-west1.run.app

# Tiempo máximo de espera de un backend, en milisegundos.
ESPERA_BACKEND_MS=90000
