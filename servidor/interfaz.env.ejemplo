# Configuración del servidor de la interfaz.
# En el servidor: copiar a /etc/martian-interfaz.env y ajustar.

# Puerto donde escucha el servidor de la interfaz.
PORT=8080
HOST=0.0.0.0

# Backends (de servidor a servidor: pueden ser http y por IP).
# Si están en la misma máquina, usar http://localhost:PUERTO.
BACKEND_1_URL=http://52.0.36.196:3000
BACKEND_2_URL=http://52.6.216.161:8000
# BACKEND_MONITOREO_URL=

# Tiempo máximo de espera de un backend, en milisegundos.
ESPERA_BACKEND_MS=90000
